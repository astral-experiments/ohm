+#[derive(Clone, Copy)]
+enum LocalDebugAddress {
+    Section(u64),
+    Discarded,
+}
+
+impl LocalDebugAddress {
+    /// An unnamed local section symbol at offset zero resolves within its own object.
+    fn for_symbol<C: ElfClass>(
+        object: &ObjectLayout<elf::Elf<C>>,
+        sym: &elf::SymtabEntry<C>,
+        section: Option<object::SectionIndex>,
+    ) -> Option<Self> {
+        if sym.st_bind() != object::elf::STB_LOCAL
+            || sym.st_type() != object::elf::STT_SECTION
+            || crate::platform::Symbol::has_name(sym)
+            || crate::platform::Symbol::value(sym) != 0
+        {
+            return None;
+        }
+        let index = section?.0;
+        match object.sections.get(index)? {
+            SectionSlot::Loaded(_) => object
+                .section_resolutions
+                .get(index)?
+                .address()
+                .filter(|&address| address != 0)
+                .map(Self::Section),
+            SectionSlot::Discard | SectionSlot::Unloaded(_) => Some(Self::Discarded),
+            _ => None,
+        }
+    }
+
+    fn with_addend(self, addend: i64, tombstone: u64) -> u64 {
+        match self {
+            Self::Section(base) => base.wrapping_add(addend as u64),
+            Self::Discarded => tombstone,
+        }
+    }
+}
+
+/// DWARF4 uses pairs of addresses for each range in a range or location list.
+/// If a pair has a different representation, the caller replays the ordinary
+/// relocations. Every write this function made before that point was absolute.
+fn write_x86_64_debug_ranges<C: ElfClass>(
+    object: &ObjectLayout<elf::Elf<C>>,
+    out: &mut [u8],
+    relocations: &[elf::Rela<C>],
+) -> Option<()> {
+    let (pairs, tail) = relocations.as_chunks::<2>();
+    if !tail.is_empty() {
+        return None;
+    }
+    for &[start, end] in pairs {
+        let start = elf::ElfRela::<C>::new(start);
+        let end = elf::ElfRela::<C>::new(end);
+        let symbol = start.symbol()?;
+        if start.raw_type() != object::elf::R_X86_64_64
+            || end.raw_type() != object::elf::R_X86_64_64
+            || end.symbol() != Some(symbol)
+            || end.offset() != start.offset().checked_add(8)?
+        {
+            return None;
+        }
+        let sym = object.object.symbol(symbol).ok()?;
+        let section = object.object.symbol_section(sym, symbol).ok()?;
+        let base = LocalDebugAddress::for_symbol::<C>(object, sym, section)?;
+        let low = base.with_addend(start.addend(), 1);
+        let high = base.with_addend(end.addend(), 1);
+        let pair = out
+            .get_mut(usize::try_from(start.offset()).ok()?..)?
+            .first_chunk_mut::<16>()?;
+        pair[..8].copy_from_slice(&low.to_le_bytes());
+        pair[8..].copy_from_slice(&high.to_le_bytes());
+    }
+    Some(())
+}
