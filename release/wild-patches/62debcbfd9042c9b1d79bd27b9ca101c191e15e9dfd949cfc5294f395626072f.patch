+//! The ELF input path must still name the same Unix file after CLI and response parsing.
+#![cfg(all(target_os = "linux", target_arch = "x86_64"))]
+
+use std::ffi::OsStr;
+use std::fs;
+use std::os::unix::ffi::OsStrExt as _;
+use std::path::Path;
+use std::process::Command;
+
+fn assemble(dir: &Path, name: &str, instruction: &str) {
+    let source = dir.join("input.s");
+    fs::write(
+        &source,
+        format!(".text\n.globl _start\n_start: mov ${instruction},%edi; mov $60,%eax; syscall\n"),
+    )
+    .unwrap();
+    assert!(
+        Command::new("as")
+            .args(["--64", "-o", name])
+            .arg(source)
+            .current_dir(dir)
+            .status()
+            .unwrap()
+            .success()
+    );
+}
+
+#[test]
+fn non_utf8_elf_paths() {
+    let temp = tempfile::tempdir().unwrap();
+    let dir = temp.path();
+    let input = OsStr::from_bytes(b"object \xff.o");
+    let output = OsStr::from_bytes(b"program \xfe");
+    let response = OsStr::from_bytes(b"@options \xfd");
+    let wild = env!("CARGO_BIN_EXE_wild");
+
+    assemble(dir, "original.o", "41");
+    fs::rename(dir.join("original.o"), dir.join(input)).unwrap();
+    // Replacing the invalid byte with U+FFFD would link a valid but different program.
+    assemble(dir, "object �.o", "99");
+    fs::write(
+        dir.join(OsStr::from_bytes(b"options \xfd")),
+        b"\"object \xff.o\"\n",
+    )
+    .unwrap();
+
+    for argument in [input, response] {
+        let status = Command::new(wild)
+            .current_dir(dir)
+            .args(["--dependency-file", "inputs.d", "-o"])
+            .arg(output)
+            .arg(argument)
+            .status()
+            .unwrap();
+        assert!(status.success());
+        assert_eq!(
+            Command::new(dir.join(output)).status().unwrap().code(),
+            Some(41)
+        );
+        let depfile = fs::read(dir.join("inputs.d")).unwrap();
+        assert!(depfile.starts_with(b"program\\ \xfe: "));
+        assert!(
+            depfile
+                .windows(b"object\\ \xff.o".len())
+                .any(|name| name == b"object\\ \xff.o")
+        );
+        fs::remove_file(dir.join(output)).unwrap();
+    }
+}
+
+#[test]
+fn non_utf8_sysroot_and_version_name() {
+    use object::Object as _;
+    use object::ObjectSection as _;
+
+    let directory = tempfile::tempdir().unwrap();
+    let root = directory.path();
+    let lib = root.join(OsStr::from_bytes(b"lib\xff"));
+    let decoy = root.join("lib�");
+    for (dir, value) in [(&lib, "41"), (&decoy, "99")] {
+        fs::create_dir(dir).unwrap();
+        assemble(dir, "entry.o", value);
+    }
+    let wild = env!("CARGO_BIN_EXE_wild");
+    let status = Command::new(wild)
+        .current_dir(root)
+        .arg("--sysroot")
+        .arg(root)
+        .arg(OsStr::from_bytes(b"-L=/lib\xff"))
+        .arg("-l:entry.o")
+        .args(["-o", "program"])
+        .status()
+        .unwrap();
+    assert!(status.success());
+    assert_eq!(
+        Command::new(root.join("program")).status().unwrap().code(),
+        Some(41)
+    );
+
+    let output = OsStr::from_bytes(b"lib\xfd.so");
+    fs::write(root.join("map"), "V1 { global: _start; local: *; };\n").unwrap();
+    assert!(
+        Command::new(wild)
+            .current_dir(root)
+            .args(["-shared", "--version-script", "map", "-o"])
+            .arg(output)
+            .arg(lib.join("entry.o"))
+            .status()
+            .unwrap()
+            .success()
+    );
+    let bytes = fs::read(root.join(output)).unwrap();
+    let elf = object::File::parse(bytes.as_slice()).unwrap();
+    let names = elf.section_by_name(".dynstr").unwrap().data().unwrap();
+    assert!(
+        names
+            .split(|&b| b == 0)
+            .any(|name| name == output.as_bytes())
+    );
+}
