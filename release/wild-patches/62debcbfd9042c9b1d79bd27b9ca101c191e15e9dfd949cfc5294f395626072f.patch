+/// Quote a native filename in a Make rule, preserving any backslashes before whitespace.
+fn write_make_path(output: &mut Vec<u8>, path: &[u8]) {
+    let mut backslashes = 0;
+    for &byte in path {
+        match byte {
+            b' ' | b'\t' => output.extend(std::iter::repeat_n(b'\\', backslashes + 1)),
+            b'#' => output.push(b'\\'),
+            b'$' => output.push(b'$'),
+            _ => (),
+        }
+        output.push(byte);
+        backslashes = if byte == b'\\' { backslashes + 1 } else { 0 };
+    }
+}
