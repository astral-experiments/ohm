+
+fn parse_os_stream(
+    args: &mut ElfArgs,
+    parser: &ArgumentParser<ElfArgs>,
+    modifiers: &mut Vec<Modifiers>,
+    input: &[std::ffi::OsString],
+    depth: usize,
