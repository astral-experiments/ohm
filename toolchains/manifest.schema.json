{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/astral-sh/ohm/blob/main/toolchains/manifest.schema.json",
  "title": "Ohm release source manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "status", "release", "sources"],
  "properties": {
    "$schema": {
      "const": "../manifest.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": ["draft", "pinned"]
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["upstream_rust_version", "ohm_revision", "toolchain_name"],
      "properties": {
        "upstream_rust_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
        },
        "ohm_revision": {
          "type": "integer",
          "minimum": 1
        },
        "toolchain_name": {
          "type": "string",
          "pattern": "^ohm-[0-9]+\\.[0-9]+\\.[0-9]+-[1-9][0-9]*$"
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rust", "cargo", "clippy"],
      "properties": {
        "rust": {
          "$ref": "#/$defs/rust_source"
        },
        "cargo": {
          "$ref": "#/$defs/cargo_source"
        },
        "clippy": {
          "$ref": "#/$defs/clippy_source"
        },
        "rustfmt": {
          "$ref": "#/$defs/rustfmt_source"
        }
      }
    },
    "bundled_tools": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "wild": {
          "type": "object",
          "additionalProperties": false,
          "required": ["version"],
          "properties": {
            "version": {
              "type": "string",
              "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "source": {
              "type": "object",
              "additionalProperties": false,
              "required": ["repository", "revision", "rust_toolchain"],
              "properties": {
                "repository": {
                  "const": "https://github.com/astral-sh/ohm-wild"
                },
                "revision": {
                  "$ref": "#/$defs/revision"
                },
                "rust_toolchain": {
                  "type": "string",
                  "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
                }
              }
            }
          },
          "oneOf": [
            {
              "required": ["sha256"],
              "not": {
                "required": ["source"]
              }
            },
            {
              "required": ["source"],
              "not": {
                "required": ["sha256"]
              }
            }
          ]
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "pinned"
          }
        }
      },
      "then": {
        "properties": {
          "sources": {
            "required": ["rustfmt"]
          }
        }
      }
    }
  ],
  "$defs": {
    "revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "rust_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "https://github.com/astral-sh/ohm-rust"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "cargo_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "https://github.com/astral-sh/ohm-cargo"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "clippy_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "https://github.com/astral-sh/ohm-rust-clippy"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    },
    "rustfmt_source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "revision"],
      "properties": {
        "repository": {
          "const": "https://github.com/astral-sh/ohm-rustfmt"
        },
        "revision": {
          "$ref": "#/$defs/revision"
        }
      }
    }
  }
}
