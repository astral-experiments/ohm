+static bool isFullVirtualCopy(const MachineInstr &MI, Register Src,
+                              Register Dst) {
+  if (!MI.isCopy() || MI.getNumOperands() != 2 || MI.isBundled() ||
+      !Src.isVirtual() || !Dst.isVirtual() || Src == Dst)
+    return false;
+  const MachineOperand &Def = MI.getOperand(0), &Use = MI.getOperand(1);
+  return Def.isReg() && Def.isDef() && Def.getReg() == Dst &&
+         !Def.getSubReg() && !Def.isImplicit() && !Def.isEarlyClobber() &&
+         !Def.isTied() && Use.isReg() && Use.isUse() && Use.readsReg() &&
+         Use.getReg() == Src && !Use.getSubReg() && !Use.isImplicit() &&
+         !Use.isTied() && !Use.isUndef();
+}
+
+// An ordinary read in the immediately following instruction keeps the same
+// value live across the removed COPY. Other uses, including PHI and subrange
+// uses, keep the complete shrink.
+static bool hasAdjacentRead(const MachineInstr &Replacement,
+                            const MachineBasicBlock &MBB, SlotIndex Cut,
+                            const VNInfo &Value, const LiveInterval &LI,
+                            LiveIntervals &LIS) {
+  Register Reg = LI.reg();
+  const MachineInstr *Next = Replacement.getNextNode();
+  if (!Next || LI.hasSubRanges() || Replacement.getParent() != &MBB ||
+      Replacement.isBundled() || Replacement.isBundle() ||
+      Replacement.isDebugInstr() || Replacement.isPHI() ||
+      Replacement.isTerminator() || Replacement.isCall() ||
+      Replacement.isInlineAsm() || Replacement.hasUnmodeledSideEffects() ||
+      LIS.getInstructionFromIndex(Cut) != &Replacement ||
+      Next->getParent() != &MBB || Next->isDebugInstr() || Next->isBundled() ||
+      Next->isPHI() || Next->isBundle() || !LIS.getSlotIndexes()->hasIndex(*Next) ||
+      llvm::any_of(Replacement.operands(), [&](const MachineOperand &MO) {
+        return MO.isReg() && MO.getReg() == Reg;
+      }))
+    return false;
+
+  SlotIndex At = LIS.getInstructionIndex(*Next).getRegSlot();
+  auto Segment = LI.FindSegmentContaining(Cut.getPrevSlot());
+  if (At <= Cut || LIS.getInstructionFromIndex(At) != Next ||
+      Segment == LI.end() || Segment->valno != &Value ||
+      !Segment->contains(At.getPrevSlot()))
+    return false;
+
+  bool ReadsValue = false;
+  for (const MachineOperand &MO : Next->operands()) {
+    if (!MO.isReg() || MO.getReg() != Reg)
+      continue;
+    if (MO.isDef() || MO.isImplicit() || MO.isTied() || MO.getSubReg() ||
+        MO.isUndef())
+      return false;
+    ReadsValue |= MO.isUse() && MO.readsReg();
+  }
+  return ReadsValue;
+}
