+    #[test]
+    fn authenticated_section_size_mismatch_is_rejected() {
+        let packed = pack_elf(&sample(), Options::default()).unwrap();
+        let section = HEADER + usize_at(&packed, 32).unwrap() + SECTION_ENTRY;
+        let index_end = HEADER + usize_at(&packed, 32).unwrap() + usize_at(&packed, 56).unwrap();
+        for length in [0, 1, 4097] {
+            let mut malformed = packed.clone();
+            put64(&mut malformed, section + 8, length);
+            let mut hasher = blake3::Hasher::new();
+            hasher.update(&malformed[..64]);
+            hasher.update(&malformed[HEADER..index_end]);
+            malformed[64..HEADER].copy_from_slice(hasher.finalize().as_bytes());
+            let object = CompactObject::parse(&malformed).unwrap();
+            assert_eq!(
+                object
+                    .read_section_with_size(&malformed, 1, 4096)
+                    .unwrap_err()
+                    .to_string(),
+                "compact ELF section size mismatch"
+            );
+            assert_eq!(object.decoded_blocks(), 0);
+            assert_eq!(
+                unpack_elf(&malformed).unwrap_err().to_string(),
+                "compact ELF section size mismatch"
+            );
+        }
+        let object = CompactObject::parse(&packed).unwrap();
+        assert_eq!(
+            object.read_section_with_size(&packed, 1, 4096).unwrap(),
+            vec![42; 4096]
+        );
+    }
