+    let version = env::var("CARGO_PKG_VERSION").ok()?;
+    Some(StableCrateId::new(
+        crate_name,
+        is_exe,
+        // The NUL keeps this private domain outside possible command-line metadata.
+        vec![format!("\0ohm-local-queries:{name}:{version}")],
+        sess.cfg_version,
+    ))
