+/// Names local query keys independently of Cargo's recursive dependency salt.
+fn ohm_lookup_id(sess: &Session, crate_name: Symbol, is_exe: bool) -> Option<StableCrateId> {
+    if !sess.opts.unstable_opts.ohm_shared_stages
