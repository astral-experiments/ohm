+    /// Records a run of new node types when these expressions have consecutive local IDs.
+    pub fn record_uniform_node_types(&mut self, fields: &[hir::Expr<'tcx>], ty: Ty<'tcx>) -> bool {
+        let Some((head, rest)) = fields.split_first() else { return true };
+        let first = head.hir_id.local_id;
+        let last = rest.last().unwrap_or(head).hir_id.local_id;
+        if self.uniform_node_types.is_some()
+            || !fields.iter().enumerate().all(|(i, field)| {
+                field.hir_id.owner == self.hir_owner
+                    && field.hir_id.local_id.as_usize().checked_sub(first.as_usize()) == Some(i)
+            })
+            || self.node_types.keys().any(|id| (first..=last).contains(id))
+        {
+            return false;
+        }
+        self.uniform_node_types = Some((first, last, ty));
+        true
+    }
+
+    /// Writes one type, preserving the previous value when a diagnostic rechecks a literal.
+    pub fn insert_node_type(&mut self, id: HirId, ty: Ty<'tcx>) -> Option<Ty<'tcx>> {
+        validate_hir_id_for_typeck_results(self.hir_owner, id);
+        if let Some((first, last, _)) = self.uniform_node_types
+            && (first..=last).contains(&id.local_id)
+        {
+            self.expand_uniform_node_types();
+        }
+        self.node_types.insert(id.local_id, ty)
+    }
+
+    /// Expands the run before an arbitrary caller can mutate one of its entries.
+    fn expand_uniform_node_types(&mut self) {
+        if let Some((first, last, ty)) = self.uniform_node_types.take() {
+            let entries = (first.as_u32()..=last.as_u32()).map(|i| (ItemLocalId::from_u32(i), ty));
+            self.node_types.extend_unord(UnordItems::new(entries));
+        }
+    }
+
